{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The hub window: event listening plus the hub's own commands, nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-apps",
    "allow-param-choices",
    "allow-launch",
    "allow-stop",
    "allow-cancel-stop",
    "allow-force-stop",
    "allow-focus",
    "allow-restart",
    "allow-dismiss",
    "allow-sessions",
    "allow-attach",
    "allow-detach",
    "allow-write-stdin",
    "allow-resize",
    "allow-list-packages",
    "allow-build",
    "allow-cancel-build",
    "allow-build-state",
    "allow-scan-data",
    "allow-open-path",
    "allow-open-url",
    "allow-open-app-folder",
    "allow-open-in-app",
    "allow-list-logs",
    "allow-env-status",
    "allow-quit-hub"
  ]
}
